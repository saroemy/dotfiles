{
    "description": "Caps Lock + H/L to switch desktops (alone: Esc nelle app col rimap, Caps Lock altrove)",
    "manipulators": [
        {
            "conditions": [
                {
                    "name": "caps_lock_held",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "h",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["control"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "name": "caps_lock_held",
                    "type": "variable_if",
                    "value": 1
                }
            ],
            "from": {
                "key_code": "l",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["control"]
                }
            ],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "bundle_identifiers": [
                        "md.obsidian",
                        "com.microsoft.VSCode",
                        "com.mitchellh.ghostty",
                        "com.philandro.anydesk"
                    ],
                    "type": "frontmost_application_if"
                }
            ],
            "from": {
                "key_code": "caps_lock",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "set_variable": {
                        "name": "caps_lock_held",
                        "value": 1
                    }
                }
            ],
            "to_after_key_up": [
                {
                    "set_variable": {
                        "name": "caps_lock_held",
                        "value": 0
                    }
                }
            ],
            "to_if_alone": [{ "key_code": "escape" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "bundle_identifiers": [
                        "md.obsidian",
                        "com.microsoft.VSCode",
                        "com.mitchellh.ghostty",
                        "com.philandro.anydesk"
                    ],
                    "type": "frontmost_application_unless"
                }
            ],
            "from": {
                "key_code": "caps_lock",
                "modifiers": { "optional": ["any"] }
            },
            "to": [
                {
                    "set_variable": {
                        "name": "caps_lock_held",
                        "value": 1
                    }
                }
            ],
            "to_after_key_up": [
                {
                    "set_variable": {
                        "name": "caps_lock_held",
                        "value": 0
                    }
                }
            ],
            "to_if_alone": [
                {
                    "hold_down_milliseconds": 100,
                    "key_code": "caps_lock"
                }
            ],
            "type": "basic"
        }
    ]
}
